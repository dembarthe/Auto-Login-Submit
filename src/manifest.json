{
  "manifest_version": 3,
  "name": "Auto Login Submit",
  "version": "1.0.0",
  "description": "Automatically submits login forms filled by your password manager, only on whitelisted domains.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Auto Login Submit", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
